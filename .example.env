# Credentials only. Runtime paths, URLs, ports and image selection belong in
# icarus.toml / icarus.local.toml or the owning application's settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek Search/Fetch is independent of the chat model; empty disables live search.
ICARUS_WEB_SEARCH_API_KEY=

# Shared PostgreSQL administrator and independent application accounts.
ICARUS_POSTGRES_PASSWORD=
ICARUS_MEM0_POSTGRES_PASSWORD=
RELA_MEM_PG_PASSWORD=
RELA_MEM_FALKORDB_PASSWORD=

# Application authentication and optional dedicated provider credentials.
ICARUS_MEM0_API_KEY=
ICARUS_MEM0_JWT_SECRET=
# When empty, the Mem0/OpenKB launchers reuse OPENAI_API_KEY.
ICARUS_MEM0_LLM_API_KEY=
ICARUS_OPENKB_API_TOKEN=
ICARUS_OPENKB_LLM_API_KEY=
ICARUS_OPENKB_PAGEINDEX_API_KEY=
RELA_MEM_API_TOKEN=

# Required together when exposing WebUI beyond loopback.
ICARUS_WEBUI_USER=
ICARUS_WEBUI_PASSWORD=

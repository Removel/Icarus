ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Must be an absolute, empty directory for the SessionStore database.
# Legacy JSONL Session data is not migrated by this release.
ICARUS_DATA_DIR=

# Mem0 service and Agent adapter. Keep values empty in this example.
ICARUS_MEM0_API_KEY=
ICARUS_MEM0_POSTGRES_PASSWORD=
ICARUS_MEM0_JWT_SECRET=
# Optional; when empty, the Mem0 launcher reuses OPENAI_API_KEY.
ICARUS_MEM0_LLM_API_KEY=
# Local-only opt-out. Keep false when API authentication is required.
ICARUS_MEM0_AUTH_DISABLED=false
ICARUS_MEM0_TELEMETRY=false
# Optional OpenAI-compatible endpoint/model overrides for Mem0 LLM and embedding.
ICARUS_MEM0_OPENAI_BASE_URL=
ICARUS_MEM0_LLM_MODEL=deepseek-v4-flash
ICARUS_MEM0_EMBEDDER_PROVIDER=fastembed
ICARUS_MEM0_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ICARUS_MEM0_EMBEDDING_DIMS=384

# OpenKB service and Agent adapter. Keep values empty in this example.
ICARUS_OPENKB_API_TOKEN=
# Optional; when empty, the OpenKB launcher reuses OPENAI_API_KEY.
ICARUS_OPENKB_LLM_API_KEY=
ICARUS_OPENKB_PAGEINDEX_API_KEY=
# Optional OpenAI-compatible endpoint/model overrides for OpenKB.
ICARUS_OPENKB_OPENAI_BASE_URL=https://api.deepseek.com
ICARUS_OPENKB_LLM_MODEL=deepseek/deepseek-v4-flash

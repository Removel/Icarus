# Values are examples, not working credentials. Keep actual values in the root .env or deployment environment.
RELA_MEM_API_TOKEN=
RELA_MEM_FALKORDB_PASSWORD=
RELA_MEM_PG_PASSWORD=
ICARUS_DATA_DIR=/absolute/path/to/icarus-data
# Optional host configuration file, mounted read-only into the application.
RELA_MEM_SETTINGS_FILE=./settings.example.json
RELA_MEM_BIND_ADDRESS=127.0.0.1
RELA_MEM_DB_BIND_ADDRESS=127.0.0.1
RELA_MEM_PORT=8767
RELA_MEM_FALKORDB_HOST_PORT=16379
RELA_MEM_PG_HOST_PORT=15432

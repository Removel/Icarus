{
  "openai_base_url": "https://api.deepseek.com",
  "anthropic_base_url": "https://api.deepseek.com/anthropic",
  "skill": {
    "allow_produce": false,
    "allow_evolve": false
  },
  "agent": {
    "max_steps": 256
  },
  "runtime": {
    "plugin_dirs": [],
    "plugin_config": {},
    "required_plugin_ids": [
      "persistence",
      "builtin-tools",
      "agent",
      "user-input",
      "skill",
      "blackboard",
      "output-bridge"
    ]
  },
  "model_settings": {
    "thinking": {
      "model_name": "deepseek-v4-pro",
      "context_window": 1000000,
      "max_tokens": 4096,
      "temperature": 0.9,
      "default_think_level": "high"
    },
    "perception": {
      "model_name": "deepseek-v4-flash",
      "context_window": 1000000,
      "max_tokens": 4096,
      "temperature": 0.6,
      "default_think_level": "high"
    }
  },
  "use_protocol": "openai"
}

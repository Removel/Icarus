$icarus-background: #0c0c0e;
$icarus-surface: #131315;
$icarus-panel: #1c1c1f;
$icarus-raised: #18181b;
$icarus-border: #4b4b51;
$icarus-muted: #97979e;
$icarus-text: #f1f1f2;
$icarus-user: #b8b8bf;
$icarus-tool: #626269;
$icarus-accent: #e0a8b6;
$icarus-green: #75bd92;
$icarus-red: #db737f;

Screen {
    background: $icarus-background;
    color: $icarus-text;
    layout: vertical;
}

#app-title {
    height: 1;
    padding: 0 2;
    color: $icarus-accent;
    text-style: bold;
    background: $icarus-raised;
}

#workspace-label {
    height: 1;
    padding: 0 2;
    color: $icarus-muted;
    background: $icarus-raised;
    text-overflow: ellipsis;
}

#conversation {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: $icarus-tool;
    scrollbar-color-hover: $icarus-user;
    scrollbar-background: $icarus-background;
}

.message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.welcome-message {
    border: round $icarus-border;
    padding: 1 2;
    background: $icarus-surface;
}

.welcome-logo {
    width: auto;
    height: 9;
}

.welcome-title {
    display: none;
    color: $icarus-accent;
    text-style: bold;
}

.welcome-workspace, .welcome-help {
    color: $icarus-muted;
}

.message-label {
    width: auto;
    color: $icarus-muted;
    text-style: bold;
}

.user-message {
    border-left: thick $icarus-user;
    padding-left: 1;
}

.user-message .message-label {
    color: $icarus-user;
}

.assistant-message {
    border-left: thick $icarus-accent;
    padding-left: 1;
}

.assistant-message .message-label {
    color: $icarus-accent;
}

.assistant-markdown {
    height: auto;
}

.tool-message {
    border-left: thick $icarus-tool;
    padding: 0 1;
    background: $icarus-surface;
}

.tool-summary {
    color: $icarus-user;
}

.tool-state {
    color: $icarus-muted;
}

.tool-message.is-success .tool-state {
    color: $icarus-green;
}

.tool-message.is-failed .tool-state {
    color: $icarus-red;
}

.error-message {
    border-left: thick $icarus-red;
    padding-left: 1;
    color: $icarus-red;
}

.turn-status {
    color: $icarus-muted;
}

.turn-failed {
    color: $icarus-red;
}

.turn-cancelled {
    color: $icarus-red;
}

#queue-panel {
    height: auto;
    max-height: 8;
    margin: 0 2;
    border-top: solid $icarus-border;
    border-bottom: solid $icarus-border;
    background: $icarus-surface;
    scrollbar-size-vertical: 1;
    scrollbar-color: $icarus-tool;
    scrollbar-background: $icarus-surface;
}

#queue-panel.is-empty {
    display: none;
}

#queue-title {
    height: 1;
    padding: 0 1;
    color: $icarus-user;
    text-style: bold;
}

#queue-items {
    height: auto;
    max-height: 6;
}

.queue-item {
    height: 1;
    padding: 0 1;
    color: $icarus-muted;
    text-overflow: ellipsis;
}

#composer-shell {
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 2;
    layout: horizontal;
    border: round $icarus-accent;
    background: $icarus-panel;
}

#composer-prompt {
    width: 3;
    height: 1;
    padding: 0 0 0 1;
    color: $icarus-accent;
    content-align: center middle;
}

#composer {
    width: 1fr;
    height: 1;
    min-height: 1;
    max-height: 8;
    border: none;
    background: $icarus-panel;
    scrollbar-size-vertical: 1;
    scrollbar-color: $icarus-tool;
    scrollbar-background: $icarus-panel;
}

#composer:focus {
    border: none;
}

#status-bar {
    height: 1;
    padding: 0 2;
    color: $icarus-muted;
    background: $icarus-surface;
    text-overflow: ellipsis;
}

#status-bar.phase-ready {
    color: $icarus-green;
}

#status-bar.phase-running {
    color: $icarus-muted;
}

#status-bar.phase-cancelling,
#status-bar.phase-failed {
    color: $icarus-red;
}

Screen.-narrow #workspace-label {
    display: none;
}

Screen.-narrow #conversation {
    padding: 0 1;
}

Screen.-narrow #queue-panel,
Screen.-narrow #composer-shell {
    margin: 0 1;
}

Screen.-narrow .welcome-help {
    display: none;
}

Screen.-compact-logo .welcome-logo,
Screen.-short .welcome-logo {
    display: none;
}

Screen.-compact-logo .welcome-title,
Screen.-short .welcome-title {
    display: block;
}

Screen.-short #composer-shell {
    max-height: 6;
}

Screen.-short #composer {
    max-height: 4;
}

Screen.-short #queue-panel {
    max-height: 3;
}

Screen.-short #queue-items {
    max-height: 1;
}

.message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.message-label {
    width: auto;
    color: $icarus-muted;
    text-style: bold;
}

.user-message {
    border-left: thick $icarus-user;
    padding-left: 1;
}

.user-message .message-label {
    color: $icarus-user;
}

.assistant-message {
    border-left: thick $icarus-accent;
    padding-left: 1;
}

.assistant-message .message-label {
    color: $icarus-accent;
}

.assistant-markdown {
    height: auto;
}

.run-card {
    border-left: solid $icarus-border;
    padding: 0 1;
    background: $icarus-surface;
}

.run-card-label {
    height: 1;
    color: $icarus-muted;
    text-style: bold;
}

.thinking-block,
.assistant-progress,
.tool-block,
.user-correction-block {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.thinking-block {
    color: $icarus-muted;
}

.thinking-content,
.assistant-progress .assistant-markdown {
    height: auto;
    padding-left: 2;
}

.disclosure-summary {
    height: 1;
    color: $icarus-user;
}

.disclosure-summary:focus {
    background: $icarus-raised;
    color: $icarus-accent;
    text-style: bold;
}

.tool-block {
    border-left: thick $icarus-tool;
    padding: 0 1;
    background: $icarus-raised;
}

.tool-summary {
    color: $icarus-user;
}

.tool-details {
    color: $icarus-muted;
    padding-left: 2;
}

.tool-block.is-success .tool-summary {
    color: $icarus-green;
}

.tool-block.is-failed .tool-summary {
    color: $icarus-red;
}

.tool-block.is-interrupted .tool-summary {
    color: $icarus-muted;
}

.correction-label {
    color: $icarus-accent;
    text-style: bold;
}

.correction-content {
    color: $icarus-user;
    padding-left: 2;
}

.error-message {
    border-left: thick $icarus-red;
    padding-left: 1;
    color: $icarus-red;
}

.turn-status {
    color: $icarus-muted;
}

.turn-failed {
    color: $icarus-red;
}

.turn-cancelled {
    color: $icarus-red;
}

.turn-interrupted {
    color: $icarus-muted;
}

.tool-records { height: 8; min-height: 8; max-height: 8; scrollbar-size-vertical: 1; scrollbar-gutter: stable; overflow-y: scroll; }
ChatScreen.-short .tool-records { height: 3; min-height: 3; max-height: 3; }
.tool-block { margin-top: 0; border-left: none; padding: 0; background: $icarus-surface; }
.run-card { border: none; padding: 0; background: $icarus-background; }
.execution-records-frame { height: auto; border: solid $icarus-border; padding: 0 1; background: $icarus-surface; }
.current-thinking { height: auto; padding: 0 1; }
.run-card-label { color: $icarus-muted; }
.thinking-block { margin-top: 0; }

.message-body-scroll { height: auto; max-height: 12; }
ChatScreen.-short .message-body-scroll { max-height: 4; }
.thinking-content { height: auto; overflow-y: hidden; }

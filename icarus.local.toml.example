# Copy to ignored icarus.local.toml. Override only machine-specific values.
# Default topology is a complete local stack; no generated Compose is needed.
[runtime]
data_dir = "~/.icarus"

# Optional process-wide nonsecret settings.
# [runtime.env]
# NO_PROXY = "localhost,127.0.0.1,::1,api.deepseek.com"

# Remote database example; keep application passwords in .env.
# [components.postgres]
# mode = "remote"
# host = "database.example.invalid"
# port = 5432

# Whole remote application example: local dependencies are not started for it.
# [components.rela-mem]
# mode = "remote"
# endpoint = "https://relationship.example.invalid"
